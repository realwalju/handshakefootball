{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": ["iad1"],
  "functions": {
    "api/game.mjs": {"maxDuration": 10}
  },
  "rewrites": [
    {"source": "/api/:operation", "destination": "/api/game?operation=:operation"},
    {"source": "/health", "destination": "/api/game?operation=health"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "no-referrer"}
    ]}
  ]
}
